{
  "name": "experiment-report",
  "displayName": "实验报告",
  "defaultStyleProfile": "excellent",
  "defaultExperimentProperty": "③验证性实验",
  "metadataFields": [
    { "key": "Name", "label": "姓名" },
    { "key": "StudentId", "label": "学号" },
    { "key": "ClassName", "label": "班级" },
    { "key": "TeacherName", "label": "指导教师" },
    { "key": "CourseName", "label": "课程名称" },
    { "key": "ExperimentName", "label": "实验名称" },
    { "key": "ExperimentProperty", "label": "实验性质", "aliases": ["实验类型", "实验类别"] },
    { "key": "ExperimentDate", "label": "实验时间", "aliases": ["实验日期", "日期", "完成日期"] },
    { "key": "ExperimentLocation", "label": "实验地点", "aliases": ["地点", "实验室", "实验场地"] }
  ],
  "extraLabels": [
    { "key": "Date", "label": "日期" },
    { "key": "FinalEdition", "label": "最终版" },
    { "key": "ExperimentNumber", "label": "实验序号", "aliases": ["实验编号", "项目序号"] },
    { "key": "Grade", "label": "成绩", "aliases": ["评分"] },
    { "key": "TeacherComment", "label": "教师评语", "aliases": ["指导教师评语", "评阅意见"] },
    { "key": "TeacherSignature", "label": "签名与日期", "aliases": ["教师签名", "批阅日期"] }
  ],
  "sectionFields": [
    {
      "key": "Purpose",
      "heading": "实验目的",
      "aliases": ["实验目的", "实验目标与验收条件", "实验任务", "目标与范围"],
      "minChars": { "standard": 30, "full": 60 }
    },
    {
      "key": "Environment",
      "heading": "实验环境",
      "aliases": ["实验环境", "实验设备与环境", "环境、工具与版本", "实验条件", "环境与材料"],
      "minChars": { "standard": 30, "full": 60 }
    },
    {
      "key": "Theory",
      "heading": "实验原理或任务要求",
      "aliases": ["实验原理或任务要求", "实验原理", "任务要求", "原理与技术方案", "原理与方案"],
      "minChars": { "standard": 30, "full": 80 }
    },
    {
      "key": "Steps",
      "heading": "实验步骤",
      "aliases": ["实验步骤", "实验过程", "实施步骤与关键配置", "方法与步骤"],
      "minChars": { "standard": 60, "full": 140 }
    },
    {
      "key": "Results",
      "heading": "实验结果",
      "aliases": ["实验结果", "实验现象与结果记录", "实验结果与分析", "测试数据与运行结果", "实验记录", "结果与证据"],
      "minChars": { "standard": 50, "full": 120 }
    },
    {
      "key": "Analysis",
      "heading": "问题分析",
      "aliases": ["问题分析", "结果分析", "问题与解决方法", "故障、定位与解决", "故障定位、结果分析与改进", "问题处理", "分析与修正"],
      "minChars": { "standard": 30, "full": 80 }
    },
    {
      "key": "Summary",
      "heading": "实验总结",
      "aliases": ["实验总结", "总结与思考", "实验小结", "实验结论", "结论与体会", "总结"],
      "minChars": { "standard": 30, "full": 80 }
    }
  ],
  "extraSectionHeadings": [
    "实验内容"
  ],
  "imagePlacementDefaults": {
    "defaultImageWidthCm": 15.8,
    "autoRowLayout": "explicit-only",
    "fallbackSectionOrder": ["steps", "result", "environment", "analysis", "summary", "purpose"],
    "defaultCaptions": {
      "environment": "实验环境截图",
      "steps": "实验步骤截图",
      "result": "实验结果截图",
      "analysis": "问题分析截图",
      "summary": "实验总结截图",
      "default": "实验过程截图"
    },
    "filenameCaptionRules": [
      { "pattern": "ping", "caption": "ping 连通性测试结果" },
      { "pattern": "arp", "caption": "arp 邻居缓存查看结果" },
      { "pattern": "ipconfig", "caption": "ipconfig 网络参数结果" },
      { "pattern": "config|setup|install|步骤|command|cmd|命令", "caption": "实验步骤截图" },
      { "pattern": "拓扑|environment|vmware|server|环境|network", "caption": "实验环境截图" },
      { "pattern": "analysis|error|problem|异常", "caption": "问题分析截图" }
    ]
  },
  "paginationRiskThresholds": {
    "longSectionChars": 900,
    "denseSectionChars": 550,
    "denseSectionParagraphs": 2,
    "figureClusterRefs": 3
  },
  "fieldMapCompositeRules": [
    {
      "matchAll": ["实验目的", "实验内容"],
      "blocks": [
        { "heading": "1 实验目的", "sectionIds": ["purpose"] },
        { "heading": "2 实验内容", "sectionIds": ["environment"] },
        { "heading": "3 实验原理", "sectionIds": ["theory"] }
      ]
    },
    {
      "matchAll": ["实验步骤", "实验小结"],
      "blocks": [
        { "heading": "4 实验步骤", "sectionIds": ["steps"] },
        { "heading": "5 实验结果", "sectionIds": ["result"] },
        { "heading": "6 问题分析", "sectionIds": ["analysis"] },
        { "heading": "7 实验小结", "sectionIds": ["summary"] }
      ]
    }
  ],
  "detailProfiles": {
    "standard": {
      "minChars": 700,
      "promptGuidance": [
        "Prefer a complete submit-ready report instead of a terse outline.",
        "Keep each required section concrete and useful, especially the steps and results sections."
      ]
    },
    "full": {
      "minChars": 2200,
      "promptGuidance": [
        "Prefer a submit-ready report with the density of a teacher-provided excellent example instead of a terse outline.",
        "Unless the reference material is very sparse, aim for roughly 2200 to 3500 Chinese characters before screenshots.",
        "Use 1, 2, 3 style section numbering and write concrete subsections such as topology, host configuration, command configuration, result verification, and summary when the experiment supports them.",
        "The steps and results sections should be the most detailed parts. Explain the setup order, key operations, command or configuration intent, observed outcomes, and why those outcomes support completion of the experiment.",
        "When screenshots are available, write figure references near the corresponding operations and keep captions short and academic.",
        "If the webpages do not provide screenshots or exact measured values, keep the language concrete and validation-oriented instead of filling space with generic filler."
      ]
    }
  },
  "forbiddenPatterns": [
    "TODO",
    "待补充",
    "自行填写",
    "可根据实际情况修改",
    "以下是一份",
    "教师点评",
    "抓包结果"
  ]
}
